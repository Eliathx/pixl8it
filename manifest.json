{
  "manifest_version": 3,
  "name": "pixl8it",
  "version": "0.1.0",
  "description": "Right-click any image to Pixelate. Downscales it and reduces it to a small indexed color palette.",
  "minimum_chrome_version": "112",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  }
}
